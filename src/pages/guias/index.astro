---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon.astro';
import { getGuias, formatDate } from '../../data/guias';

const guias = await getGuias();
---

<ContentLayout
  title="Guías sobre desarrollo de software para empresas | BUILDEV"
  description="Guías prácticas para empresas en Colombia: cómo planear, contratar y aprovechar el desarrollo de software a la medida, apps y automatización de procesos."
  eyebrow="Guías"
  heading="Guías para construir con tecnología"
  lead="Respuestas claras a las preguntas que se hacen las empresas antes de invertir en software."
>
  <ul class="guias">
    {
      guias.map((g) => (
        <li>
          <a href={`/guias/${g.id}/`} class="guia">
            <time datetime={g.data.pubDate.toISOString()}>{formatDate(g.data.pubDate)}</time>
            <h2>{g.data.title}</h2>
            <p>{g.data.description}</p>
            <span class="guia__more">
              Leer guía <Icon name="arrow" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</ContentLayout>

<style>
  .guias {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guia {
    display: grid;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .guia:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  time {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-muted);
  }
  h2 {
    font-size: 1.3rem;
  }
  p {
    color: var(--c-muted);
  }
  .guia__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--c-blue);
  }
</style>
