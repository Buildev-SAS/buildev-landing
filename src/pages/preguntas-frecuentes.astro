---
import ContentLayout from '../layouts/ContentLayout.astro';
import FaqList from '../components/FaqList.astro';
import { faqGroups } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups
    .flatMap((g) => g.items)
    .map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
};
---

<ContentLayout
  title="Preguntas frecuentes sobre desarrollo de software | BUILDEV"
  description="Resolvemos las dudas más comunes sobre desarrollo de software a la medida en Colombia: servicios, tiempos, costos, soporte y cómo empezar un proyecto con BUILDEV."
  eyebrow="Preguntas frecuentes"
  heading="Preguntas frecuentes"
  lead="Lo que más nos preguntan las empresas antes de empezar un proyecto de software con nosotros."
  schema={[faqSchema]}
>
  {
    faqGroups.map((group) => (
      <section class="faq-group">
        <h2>{group.title}</h2>
        <FaqList items={group.items} />
      </section>
    ))
  }
</ContentLayout>

<style>
  .faq-group + .faq-group {
    margin-top: 48px;
  }
  h2 {
    margin-bottom: 18px;
    font-size: 1.35rem;
  }
</style>
