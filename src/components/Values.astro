---
import Icon, { type IconName } from './Icon.astro';
import { getLang, type Lang } from '../i18n';

const lang = getLang(Astro.url);
const ariaLabel = { es: 'Nuestros valores', en: 'Our values' }[lang];

const values: { icon: IconName; label: Record<Lang, string> }[] = [
  { icon: 'rocket', label: { es: 'Innovación', en: 'Innovation' } },
  { icon: 'shield', label: { es: 'Confianza', en: 'Trust' } },
  { icon: 'users', label: { es: 'Trabajo en equipo', en: 'Teamwork' } },
  { icon: 'code', label: { es: 'Soluciones reales', en: 'Real solutions' } },
  { icon: 'growth', label: { es: 'Crecimiento', en: 'Growth' } },
];
---

<section class="values" aria-label={ariaLabel}>
  <div class="container">
    <ul class="values__list">
      {
        values.map((v, i) => (
          <li class="reveal" style={`transition-delay:${i * 70}ms`}>
            <Icon name={v.icon} size={32} />
            <span>{v.label[lang]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .values {
    padding-block: 56px;
    border-block: 1px solid var(--c-border);
  }
  .values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .values__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    text-align: center;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--c-muted);
  }
  .values__list li + li {
    border-left: 1px solid var(--c-border);
  }
  .values__list :global(svg) {
    color: var(--c-blue);
  }
  .values__list li:nth-child(odd) :global(svg) {
    color: #6cc04a;
  }

  @media (max-width: 760px) {
    .values__list {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 28px;
    }
    .values__list li + li {
      border-left: 0;
    }
  }
  @media (max-width: 420px) {
    .values__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
