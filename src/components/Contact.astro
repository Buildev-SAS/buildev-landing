---
import Icon from './Icon.astro';
import Stripes from './Stripes.astro';
import { site } from '../data/site';
import { getLang, paths } from '../i18n';

const lang = getLang(Astro.url);
// Opciones del servicio: en inglés se muestran traducidas, pero Netlify recibe siempre el valor en español.
const services = ['Software a la medida', 'Aplicación web', 'App móvil', 'Automatización de procesos', 'Integraciones y APIs', 'Otro'];
// Solo se traducen los textos visibles: los `name` del formulario son los mismos en ambos idiomas
// para que Netlify guarde todos los envíos en el mismo formulario "contacto".
const copy = {
  es: {
    eyebrow: 'Contacto',
    title: '¿Tienes una idea? Construyámosla juntos',
    lead: 'Cuéntanos sobre tu proyecto y te respondemos con una propuesta clara, sin compromiso.',
    email: 'Correo',
    whatsapp: 'Escríbenos directamente',
    location: 'Ubicación',
    honeypot: 'No llenes este campo:',
    name: 'Nombre *',
    namePh: 'Tu nombre',
    company: 'Empresa',
    companyPh: 'Nombre de tu empresa',
    mail: 'Correo *',
    mailPh: 'tucorreo@empresa.com',
    phone: 'Teléfono',
    need: '¿Qué necesitas?',
    options: services,
    message: 'Mensaje *',
    messagePh: 'Cuéntanos brevemente sobre tu proyecto',
    consent: 'Autorizo a BUILDEV a usar mis datos para responder mi solicitud, según la',
    policy: 'política de privacidad',
    submit: 'Enviar mensaje',
    waText: 'Hola BUILDEV, quiero información sobre un proyecto de software.',
  },
  en: {
    eyebrow: 'Contact',
    title: "Have an idea? Let's build it together",
    lead: "Tell us about your project and we'll reply with a clear proposal, no strings attached.",
    email: 'Email',
    whatsapp: 'Message us directly',
    location: 'Location',
    honeypot: 'Do not fill out this field:',
    name: 'Name *',
    namePh: 'Your name',
    company: 'Company',
    companyPh: 'Your company name',
    mail: 'Email *',
    mailPh: 'you@company.com',
    phone: 'Phone',
    need: 'What do you need?',
    options: ['Custom software', 'Web application', 'Mobile app', 'Process automation', 'Integrations and APIs', 'Other'],
    message: 'Message *',
    messagePh: 'Tell us briefly about your project',
    consent: 'I authorize BUILDEV to use my data to respond to my request, as described in the',
    policy: 'privacy policy',
    submit: 'Send message',
    waText: "Hi BUILDEV, I'd like information about a software project.",
  },
}[lang];

const waText = encodeURIComponent(copy.waText);
// En pantallas angostas el correo parte después de la arroba, no en cualquier letra.
const [emailUser, emailDomain] = site.email.split('@');
---

<section class="section contact" id="contacto">
  <Stripes class="contact__stripes" />
  <div class="container contact__grid">
    <div class="contact__info reveal">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="section-title">{copy.title}</h2>
      <p class="contact__lead">
        {copy.lead}
      </p>

      <ul class="contact__channels">
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="ch-icon"><Icon name="mail" size={20} /></span>
            <span><small>{copy.email}</small>{emailUser}@<wbr />{emailDomain}</span>
          </a>
        </li>
        <li>
          <a href={`https://wa.me/${site.whatsapp}?text=${waText}`} target="_blank" rel="noopener">
            <span class="ch-icon"><Icon name="chat" size={20} /></span>
            <span><small>WhatsApp</small>{copy.whatsapp}</span>
          </a>
        </li>
        <li>
          <span class="ch-row">
            <span class="ch-icon"><Icon name="pin" size={20} /></span>
            <span><small>{copy.location}</small>{site.city}</span>
          </span>
        </li>
      </ul>
    </div>

    <form
      class="form reveal"
      name="contacto"
      method="POST"
      action={paths.thanks[lang]}
      data-netlify="true"
      netlify-honeypot="empresa-web"
    >
      <input type="hidden" name="form-name" value="contacto" />
      <p class="sr-only">
        <label>{copy.honeypot} <input name="empresa-web" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="form__row">
        <label>
          <span>{copy.name}</span>
          <input type="text" name="nombre" required autocomplete="name" placeholder={copy.namePh} />
        </label>
        <label>
          <span>{copy.company}</span>
          <input type="text" name="empresa" autocomplete="organization" placeholder={copy.companyPh} />
        </label>
      </div>
      <div class="form__row">
        <label>
          <span>{copy.mail}</span>
          <input type="email" name="correo" required autocomplete="email" placeholder={copy.mailPh} />
        </label>
        <label>
          <span>{copy.phone}</span>
          <input type="tel" name="telefono" autocomplete="tel" placeholder="+57 300 000 0000" />
        </label>
      </div>
      <label>
        <span>{copy.need}</span>
        <select name="servicio">
          {copy.options.map((o, i) => <option value={services[i]}>{o}</option>)}
        </select>
      </label>
      <label>
        <span>{copy.message}</span>
        <textarea name="mensaje" rows="4" required placeholder={copy.messagePh}></textarea>
      </label>
      <!-- Autorización de tratamiento de datos (Ley 1581 de 2012). Netlify guarda el valor con el mensaje. -->
      <label class="form__consent">
        <input type="checkbox" name="autorizacion" value="Sí" required />
        <span>
          {copy.consent}
          <a href={paths.privacy[lang]} target="_blank" rel="noopener">{copy.policy}</a>. *
        </span>
      </label>
      <button type="submit" class="btn btn--primary form__submit">
        {copy.submit} <Icon name="arrow" size={18} />
      </button>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--c-ink-900), var(--c-ink));
    color: #fff;
  }
  .contact :global(.contact__stripes) {
    position: absolute;
    right: -140px;
    top: -60px;
    width: 620px;
    height: auto;
    opacity: 0.14;
    pointer-events: none;
  }
  .contact__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .contact .eyebrow {
    color: #6fdcf0;
  }
  .contact__lead {
    margin-top: 16px;
    font-size: 1.08rem;
    color: rgb(255 255 255 / 0.72);
  }
  .contact__channels {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact__channels a,
  .ch-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.04);
    font-weight: 600;
    overflow-wrap: anywhere;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .contact__channels a:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(166 217 54 / 0.5);
  }
  .contact__channels small {
    display: block;
    font-size: 0.74rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.55);
  }
  .ch-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgb(166 217 54 / 0.15);
    color: var(--c-lime);
  }

  .form {
    display: grid;
    gap: 18px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 22px;
    background: #fff;
    color: var(--c-ink);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .form label {
    display: grid;
    gap: 6px;
  }
  .form label > span {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--c-border);
    background: var(--c-bg-soft);
    font: inherit;
    font-size: 0.95rem;
    color: var(--c-ink);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .form textarea {
    resize: vertical;
    min-height: 110px;
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--c-cyan);
    background: #fff;
  }
  .form__consent {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 10px;
  }
  .form .form__consent input {
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    padding: 0;
    accent-color: var(--c-blue);
  }
  .form .form__consent span {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--c-muted);
  }
  .form__consent a {
    color: var(--c-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form__submit {
    justify-self: start;
    margin-top: 4px;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .form__row {
      grid-template-columns: 1fr;
    }
    .form__submit {
      justify-self: stretch;
    }
  }
  @media (max-width: 380px) {
    .contact__channels a,
    .ch-row {
      gap: 12px;
      padding: 12px 14px;
      font-size: 0.94rem;
    }
    .ch-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
