---
import Icon from './Icon.astro';
import Stripes from './Stripes.astro';
---

<section class="hero" id="inicio">
  <Stripes class="hero__stripes" />
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__badge">
        <span class="dot"></span> Desarrollo de software · Colombia
      </span>
      <h1>
        Soluciones de software que <span class="text-grad">impulsan tu negocio</span>
      </h1>
      <p class="hero__lead">
        Desarrollo, automatización e innovación a tu medida. Convertimos tus procesos en productos digitales
        escalables, seguros y listos para crecer contigo.
      </p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">
          Comenzar ahora <Icon name="arrow" size={18} />
        </a>
        <a href="#servicios" class="btn btn--ghost">Ver servicios</a>
      </div>
      <ul class="hero__points">
        <li><Icon name="check" size={18} /> Software a la medida</li>
        <li><Icon name="check" size={18} /> Entrega puntual</li>
        <li><Icon name="check" size={18} /> Soporte continuo</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="window">
        <div class="window__bar">
          <span></span><span></span><span></span>
          <em>buildev.co</em>
        </div>
        <pre class="window__code"><code><span class="k">const</span> <span class="v">negocio</span> = <span class="k">await</span> <span class="f">buildev</span>.<span class="f">transformar</span>({'{'}
  <span class="p">procesos</span>: <span class="s">'automatizados'</span>,
  <span class="p">escala</span>: <span class="s">'sin límites'</span>,
  <span class="p">seguridad</span>: <span class="b">true</span>,
{'}'});

<span class="c">// ✓ Listo para crecer</span>
<span class="v">negocio</span>.<span class="f">crecer</span>();</code></pre>
      </div>
      <div class="float-card float-card--a">
        <Icon name="growth" size={22} />
        <div><strong>+ Eficiencia</strong><small>Procesos optimizados</small></div>
      </div>
      <div class="float-card float-card--b">
        <Icon name="shield" size={22} />
        <div><strong>Seguro</strong><small>Buenas prácticas</small></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(1200px 600px at 85% 20%, #26414f 0%, transparent 60%),
      linear-gradient(160deg, var(--c-ink-900) 0%, var(--c-ink) 100%);
    color: #fff;
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 96px));
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .hero :global(.hero__stripes) {
    position: absolute;
    right: -120px;
    bottom: -60px;
    width: min(760px, 90vw);
    height: auto;
    opacity: 0.22;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    width: 520px;
    height: 520px;
    left: -200px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(166 217 54 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 56px;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(255 255 255 / 0.05);
    font-size: 0.8rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-lime);
    box-shadow: 0 0 0 4px rgb(166 217 54 / 0.25);
  }
  .hero h1 {
    margin-top: 22px;
    font-size: clamp(2.3rem, 5.4vw, 3.9rem);
    letter-spacing: -0.03em;
  }
  .hero__lead {
    margin-top: 22px;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    color: rgb(255 255 255 / 0.75);
    max-width: 54ch;
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero__points {
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.75);
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__points :global(svg) {
    color: var(--c-lime);
  }

  /* Visual */
  .hero__visual {
    position: relative;
    padding: 30px 10px;
  }
  .window {
    border-radius: var(--radius);
    background: rgb(15 22 28 / 0.85);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .window__bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .window__bar span:first-child {
    background: var(--c-lime);
  }
  .window__bar em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.45);
  }
  .window__code {
    margin: 0;
    padding: 24px 22px 28px;
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', Menlo, monospace;
    font-size: clamp(0.78rem, 1.3vw, 0.92rem);
    line-height: 1.8;
    color: #d6e2ea;
    overflow-x: auto;
  }
  .k { color: #7fd3f0; }
  .v { color: #fff; }
  .f { color: var(--c-lime); }
  .p { color: #9fb3c2; }
  .s { color: #5fd0e6; }
  .b { color: #f0b86e; }
  .c { color: #6f8494; }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 14px;
    background: #fff;
    color: var(--c-ink);
    box-shadow: var(--shadow-lg);
    animation: float 6s ease-in-out infinite;
  }
  .float-card div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .float-card strong {
    font-size: 0.9rem;
  }
  .float-card small {
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .float-card--a {
    left: -18px;
    bottom: -4px;
  }
  .float-card--a :global(svg) {
    color: #6cc04a;
  }
  .float-card--b {
    right: -8px;
    top: 0;
    animation-delay: -3s;
  }
  .float-card--b :global(svg) {
    color: var(--c-blue);
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .float-card {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero__visual {
      max-width: 560px;
    }
  }
  @media (max-width: 520px) {
    .float-card--a {
      left: 4px;
    }
    .float-card--b {
      right: 8px;
    }
  }
</style>
