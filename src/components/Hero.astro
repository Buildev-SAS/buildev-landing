---
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const copy = {
  es: {
    title: 'Soluciones de software que impulsan tu negocio.',
    lead: 'Convertimos tus procesos en productos digitales escalables, seguros y listos para crecer contigo.',
    start: 'Comenzar ahora',
    seeServices: 'Ver servicios',
    scroll: 'Desliza para explorar',
    pause: 'Pausar animación',
    play: 'Reanudar animación',
  },
  en: {
    title: 'Software solutions that drive your business.',
    lead: 'We turn your processes into digital products that are scalable, secure and ready to grow with you.',
    start: 'Get started',
    seeServices: 'View services',
    scroll: 'Scroll to explore',
    pause: 'Pause animation',
    play: 'Resume animation',
  },
}[lang];
---

<section class="hero" id="inicio">
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <h1>{copy.title}</h1>
    <p class="hero__lead">{copy.lead}</p>
    <div class="hero__actions">
      <a href="#contacto" class="btn btn--primary hero__btn">{copy.start}</a>
      <a href="#servicios" class="hero__link">{copy.seeServices} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="container hero__bar">
    <a href="#servicios" class="hero__scroll">{copy.scroll} <span aria-hidden="true">↓</span></a>
    <button
      type="button"
      class="hero__pause"
      data-hero-pause
      aria-pressed="false"
      data-pause-label={copy.pause}
      data-play-label={copy.play}
    >
      {copy.pause}
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(160deg, var(--c-ink-900) 0%, var(--c-ink) 100%);
    color: #fff;
    padding-top: var(--header-h);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: 64px;
  }
  .hero h1 {
    max-width: 16ch;
    font-size: clamp(3rem, 7.4vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .hero__lead {
    margin-top: 28px;
    max-width: 36rem;
    font-size: 1.125rem;
    color: rgb(255 255 255 / 0.7);
  }
  .hero__actions {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }
  .hero__btn {
    box-shadow: none;
  }
  .hero__link {
    font-weight: 600;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.85);
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    padding-bottom: 3px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .hero__link span {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .hero__link:hover {
    color: #fff;
    border-color: var(--c-lime);
  }
  .hero__link:hover span {
    transform: translateX(4px);
  }

  .hero__bar {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.55);
  }
  .hero__scroll:hover,
  .hero__pause:hover {
    color: #fff;
  }
  .hero__pause {
    background: none;
    border: 0;
    padding: 6px 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    cursor: pointer;
  }
  .hero__pause::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--c-lime);
    vertical-align: 1px;
  }
  .hero__pause[aria-pressed='true']::before {
    background: rgb(255 255 255 / 0.35);
  }
  .hero__scroll span {
    display: inline-block;
    animation: nudge 2.4s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll span {
      animation: none;
    }
  }
  @media (max-width: 520px) {
    .hero__inner {
      padding-block: 48px;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-hero-pause]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx && pauseBtn) {
    type Node = { x: number; y: number; vx: number; vy: number };
    const LIME = '166, 217, 54';
    const LINK = 150;
    const MOUSE_R = 170;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let w = 0;
    let h = 0;
    let nodes: Node[] = [];
    let raf = 0;
    let userPaused = reduced.matches;
    let visible = true;
    const mouse = { x: -9999, y: -9999 };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(110, Math.max(28, (w * h) / 15000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
      }));
      draw();
    };

    const step = () => {
      for (const n of nodes) {
        // Los nodos se apartan suavemente del cursor.
        const dx = n.x - mouse.x;
        const dy = n.y - mouse.y;
        const d = Math.hypot(dx, dy);
        if (d < MOUSE_R && d > 0) {
          const f = ((MOUSE_R - d) / MOUSE_R) * 0.06;
          n.vx += (dx / d) * f;
          n.vy += (dy / d) * f;
        }
        n.vx *= 0.995;
        n.vy *= 0.995;
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
        n.x = Math.min(w, Math.max(0, n.x));
        n.y = Math.min(h, Math.max(0, n.y));
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx.strokeStyle = `rgba(${LIME}, ${(1 - d / LINK) * 0.8})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        // Líneas hacia el cursor.
        const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (dm < MOUSE_R) {
          ctx.strokeStyle = `rgba(${LIME}, ${(1 - dm / MOUSE_R) * 0.9})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
        }
        ctx.fillStyle = `rgba(${LIME}, 0.9)`;
        ctx.beginPath();
        ctx.arc(a.x, a.y, 1.8, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const loop = () => {
      step();
      draw();
      raf = requestAnimationFrame(loop);
    };

    const sync = () => {
      const shouldRun = !userPaused && visible && !document.hidden;
      if (shouldRun && !raf) raf = requestAnimationFrame(loop);
      if (!shouldRun && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    const renderButton = () => {
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseBtn.textContent = userPaused ? pauseBtn.dataset.playLabel! : pauseBtn.dataset.pauseLabel!;
    };

    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      renderButton();
      sync();
    });

    const hero = canvas.parentElement!;
    hero.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    });
    hero.addEventListener('pointerleave', () => {
      mouse.x = mouse.y = -9999;
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(hero);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('resize', resize);

    renderButton();
    resize();
    sync();
  }
</script>
