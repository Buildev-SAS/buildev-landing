---
interface Props {
  variant?: 'light' | 'dark';
  showTagline?: boolean;
  iconOnly?: boolean;
  class?: string;
}

const { variant = 'light', showTagline = true, iconOnly = false, class: className } = Astro.props;
// IDs únicos para que varios logos en la misma página no compartan gradientes.
const uid = Math.random().toString(36).slice(2, 8);
---

<span class:list={['logo', `logo--${variant}`, className]}>
  <svg class="logo__icon" viewBox="0 0 100 120" aria-hidden="true">
    <defs>
      <linearGradient id={`lg-a-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#A6D936"></stop>
        <stop offset="1" stop-color="#6CC04A"></stop>
      </linearGradient>
      <linearGradient id={`lg-c-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#00B8D9"></stop>
        <stop offset="1" stop-color="#0077B6"></stop>
      </linearGradient>
    </defs>
    <g stroke-linejoin="round" stroke-width="6">
      <polygon points="12,6 88,48 62,62 12,34" fill={`url(#lg-a-${uid})`} stroke={`url(#lg-a-${uid})`}></polygon>
      <polygon points="12,43 48,62 12,80" fill="#00B8D9" stroke="#00B8D9"></polygon>
      <polygon points="12,88 62,59 88,73 12,114" fill={`url(#lg-c-${uid})`} stroke={`url(#lg-c-${uid})`}></polygon>
    </g>
  </svg>
  {
    !iconOnly && (
      <span class="logo__text">
        <span class="logo__word">
          <span class="logo__buil">BUIL</span><span class="logo__dev">DEV</span>
        </span>
        {showTagline && <span class="logo__tagline">Software Solutions &amp; Innovation</span>}
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    line-height: 1;
  }
  .logo__icon {
    height: 2.4em;
    width: auto;
    flex-shrink: 0;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .logo__word {
    font-weight: 800;
    font-size: 1.55em;
    letter-spacing: -0.02em;
  }
  .logo__buil {
    color: var(--c-ink);
  }
  .logo--dark .logo__buil {
    color: #fff;
  }
  .logo__dev {
    background: linear-gradient(90deg, var(--c-lime), #6cc04a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .logo__tagline {
    font-size: 0.52em;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    white-space: nowrap;
  }
  .logo--dark .logo__tagline {
    color: rgb(255 255 255 / 0.7);
  }
</style>
