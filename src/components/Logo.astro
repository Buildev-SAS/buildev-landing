---
interface Props {
  variant?: 'light' | 'dark';
  showTagline?: boolean;
  iconOnly?: boolean;
  class?: string;
}

const { variant = 'light', showTagline = true, iconOnly = false, class: className } = Astro.props;

// Fondo oscuro: letras blancas. Fondo claro: letras oscuras con el tagline ya incluido en el SVG.
const isDark = variant === 'dark';
const logoSrc = isDark ? '/logo-buildev.svg' : '/logo-buildev-completo.svg';
---

<span class:list={['logo', `logo--${variant}`, className]}>
  <img src={logoSrc} alt="BUILDEV - Software Solutions & Innovation" class="logo__image" />
  {
    isDark && !iconOnly && showTagline && (
      <span class="logo__tagline">Software Solutions &amp; Innovation</span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    line-height: 1;
  }
  .logo__image {
    height: 2.4em;
    width: auto;
    flex-shrink: 0;
  }
  .logo--light .logo__image {
    height: 3em;
  }
  .logo__tagline {
    font-size: 0.52em;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    white-space: nowrap;
  }
  .logo--dark .logo__tagline {
    color: rgb(255 255 255 / 0.7);
  }
</style>
