---
import Icon, { type IconName } from './Icon.astro';
import Logo from './Logo.astro';
import { getLang, type Lang } from '../i18n';

const lang = getLang(Astro.url);
const copy = {
  es: {
    eyebrow: 'Quiénes somos',
    title: 'Construimos el software que tu empresa necesita para crecer',
    // Va después de <strong>BUILDEV</strong>.
    text: 'es una empresa de desarrollo de software comprometida con la innovación, la eficiencia y la transformación digital. Diseñamos soluciones tecnológicas escalables que optimizan procesos y potencian el crecimiento empresarial.',
    tags: ['Minimalista', 'Profesional', 'Moderno', 'Tecnológico', 'Confiable'],
    why: '¿Por qué elegirnos?',
  },
  en: {
    eyebrow: 'Who we are',
    title: 'We build the software your company needs to grow',
    text: 'is a software development company committed to innovation, efficiency and digital transformation. We design scalable technology solutions that streamline processes and accelerate business growth.',
    tags: ['Minimalist', 'Professional', 'Modern', 'Tech-driven', 'Reliable'],
    why: 'Why choose us?',
  },
}[lang];

const reasons: { icon: IconName; title: Record<Lang, string>; text: Record<Lang, string> }[] = [
  {
    icon: 'target',
    title: { es: 'Enfoque en resultados y calidad', en: 'Focused on results and quality' },
    text: {
      es: 'Cada entrega se mide por el impacto que genera en tu negocio.',
      en: 'Every delivery is measured by the impact it has on your business.',
    },
  },
  {
    icon: 'chat',
    title: { es: 'Comunicación constante y transparente', en: 'Constant, transparent communication' },
    text: {
      es: 'Sabes en qué estamos, qué sigue y cuándo lo tendrás.',
      en: "You always know what we're working on, what's next and when you'll have it.",
    },
  },
  {
    icon: 'shield',
    title: { es: 'Soluciones escalables y seguras', en: 'Scalable, secure solutions' },
    text: {
      es: 'Arquitecturas preparadas para crecer y proteger tu información.',
      en: 'Architectures built to scale and to protect your information.',
    },
  },
  {
    icon: 'clock',
    title: { es: 'Entrega puntual y soporte continuo', en: 'On-time delivery and ongoing support' },
    text: {
      es: 'Cumplimos los tiempos y seguimos a tu lado después del lanzamiento.',
      en: 'We meet deadlines and stay by your side after launch.',
    },
  },
];
---

<section class="section about" id="nosotros">
  <div class="container about__grid">
    <div class="about__intro reveal">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="section-title">{copy.title}</h2>
      <p class="about__text">
        <strong>BUILDEV</strong> {copy.text}
      </p>

      <div class="about__card">
        <Logo class="about__logo" />
        <ul class="about__tags">
          {copy.tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>

    <div class="about__why">
      <h3 class="why__title reveal">{copy.why}</h3>
      <ul class="why__list">
        {
          reasons.map((r, i) => (
            <li class="why__item reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="why__icon">
                <Icon name={r.icon} size={24} />
              </span>
              <div>
                <h4>{r.title[lang]}</h4>
                <p>{r.text[lang]}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .about__text {
    margin-top: 20px;
    font-size: 1.08rem;
    color: var(--c-muted);
  }
  .about__text strong {
    color: var(--c-ink);
  }
  .about__card {
    margin-top: 36px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
  }
  .about__card :global(.about__logo) {
    font-size: 18px;
  }
  .about__tags {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .about__tags li {
    padding: 6px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--c-border);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-muted);
  }

  .why__title {
    font-size: 1.5rem;
  }
  .why__list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .why__item {
    display: flex;
    gap: 18px;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--c-border);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease,
      opacity 0.7s ease;
  }
  .why__item:hover {
    box-shadow: var(--shadow);
    transform: translateX(4px);
  }
  .why__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--c-ink);
    color: var(--c-lime);
  }
  .why__item h4 {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .why__item p {
    margin-top: 4px;
    font-size: 0.94rem;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .about__card :global(.about__logo) {
      font-size: 15px;
    }
  }
</style>
