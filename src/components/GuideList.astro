---
// Listado de guías (/guias/ y /en/guides/) o de artículos del blog (/blog/).
import ContentLayout from '../layouts/ContentLayout.astro';
import Icon from './Icon.astro';
import { getGuias, guiaHref, formatDate } from '../data/guias';
import { getPosts, postHref } from '../data/blog';
import { getLang } from '../i18n';

interface Props {
  blog?: boolean;
}

const lang = getLang(Astro.url);
const guias = Astro.props.blog
  ? (await getPosts()).map((p) => ({ data: p.data, href: postHref(p.id) }))
  : (await getGuias(lang)).map((g) => ({ data: g.data, href: guiaHref(lang, g.id) }));

const blogCopy = {
  title: 'Blog de tecnología: noticias del sector TI con opinión | BUILDEV',
  description:
    'Cada 8 días, la noticia más importante del sector TI explicada sin rodeos y con la opinión práctica del equipo de BUILDEV: qué pasó y qué hacer.',
  eyebrow: 'Blog',
  heading: 'Lo que pasa en tecnología, y lo que significa para tu negocio',
  lead: 'Cada 8 días elegimos la noticia más importante del sector TI y te contamos qué pasó, qué opinamos y qué hacer.',
  more: 'Leer artículo',
};

const copy = Astro.props.blog ? blogCopy : {
  es: {
    title: 'Guías sobre desarrollo de software para empresas | BUILDEV',
    description:
      'Guías prácticas para empresas en Colombia: cómo planear, contratar y aprovechar el desarrollo de software a la medida, apps y automatización de procesos.',
    eyebrow: 'Guías',
    heading: 'Guías para construir con tecnología',
    lead: 'Respuestas claras a las preguntas que se hacen las empresas antes de invertir en software.',
    more: 'Leer guía',
  },
  en: {
    title: 'Software development guides for businesses | BUILDEV',
    description:
      'Practical guides for businesses: how to plan, hire and get the most out of custom software development, mobile apps and process automation.',
    eyebrow: 'Guides',
    heading: 'Guides to building with technology',
    lead: 'Clear answers to the questions businesses ask before investing in software.',
    more: 'Read guide',
  },
}[lang];
---

<ContentLayout
  title={copy.title}
  description={copy.description}
  eyebrow={copy.eyebrow}
  heading={copy.heading}
  lead={copy.lead}
>
  <ul class="guias">
    {
      guias.map((g) => (
        <li>
          <a href={g.href} class="guia">
            <time datetime={g.data.pubDate.toISOString()}>{formatDate(g.data.pubDate, lang)}</time>
            <h2>{g.data.title}</h2>
            <p>{g.data.description}</p>
            <span class="guia__more">
              {copy.more} <Icon name="arrow" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</ContentLayout>

<style>
  .guias {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guia {
    display: grid;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .guia:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  time {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-muted);
  }
  h2 {
    font-size: 1.3rem;
  }
  p {
    color: var(--c-muted);
  }
  .guia__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--c-blue);
  }
</style>
