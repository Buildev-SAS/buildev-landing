---
import Icon, { type IconName } from './Icon.astro';
import Stripes from './Stripes.astro';
import Agendorio from './projects/Agendorio.astro';
import Rentablo from './projects/Rentablo.astro';
import '../styles/showcase.css';

// Proyectos del carrusel, en orden. Para sumar uno, crea su tarjeta en ./projects y agrégalo aquí;
// `color` es el fondo de su botón en el selector (el mismo de su tarjeta).
const projects: { id: string; name: string; type: string; icon: IconName; color: string; Card: typeof Agendorio }[] = [
  { id: 'agendorio', name: 'Agendorio', type: 'Plataforma SaaS', icon: 'calendar', color: '#1c252d', Card: Agendorio },
  { id: 'rentablo', name: 'Rentablo', type: 'App móvil', icon: 'phone', color: '#0f4d45', Card: Rentablo },
];

// El carrusel da la vuelta y muestra un proyecto a cada lado del activo;
// con menos de tres se repiten para que ningún lado quede vacío.
const slides = projects.length < 3 ? [...projects, ...projects] : projects;

// Posición inicial de cada tarjeta: 0 al centro, ±1 a los lados, el resto escondidas.
const relOf = (i: number) => (i > slides.length / 2 ? i - slides.length : i);
---

<section class="section projects" id="proyectos" data-carousel>
  <Stripes class="projects__stripes" muted />
  <div class="container">
    <header class="projects__head reveal">
      <span class="eyebrow">En producción</span>
      <h2 class="section-title">Construcciones que ya están funcionando</h2>
      <p class="section-lead">
        Nuestros productos operan en producción y ayudan a negocios reales todos los días.
      </p>
    </header>

    <div class="picker reveal" role="group" aria-label="Elige un proyecto" data-picker>
      {
        projects.map((p, i) => (
          <button
            type="button"
            class="picker__item"
            style={`--pick-color: ${p.color}`}
            aria-controls={`proyecto-${p.id}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="picker__icon">
              <Icon name={p.icon} size={18} />
            </span>
            <span class="picker__text">
              <strong>{p.name}</strong>
              <small>{p.type}</small>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="carousel reveal" role="region" aria-roledescription="carrusel" aria-label="Proyectos">
    <div class="carousel__stage" data-stage>
      {
        slides.map(({ id, name, Card }, i) => {
          const project = i % projects.length;
          const rel = relOf(i);
          return (
            <div
              class:list={['carousel__slide', { 'is-active': rel === 0, 'is-side': Math.abs(rel) === 1 }]}
              id={i === project ? `proyecto-${id}` : undefined}
              style={`--rel: ${rel}`}
              data-project={project}
              role="group"
              aria-roledescription="proyecto"
              aria-label={`${project + 1} de ${projects.length}: ${name}`}
              inert={rel !== 0}
            >
              <Card />
            </div>
          );
        })
      }
    </div>
    <button type="button" class="carousel__arrow carousel__arrow--prev" aria-label="Proyecto anterior" data-prev>
      <Icon name="arrow" size={20} />
    </button>
    <button type="button" class="carousel__arrow carousel__arrow--next" aria-label="Proyecto siguiente" data-next>
      <Icon name="arrow" size={20} />
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const slides = [...(stage?.children ?? [])] as HTMLElement[];
  const picks = [...(root?.querySelectorAll<HTMLButtonElement>('[data-picker] button') ?? [])];
  let current = 0;

  // Posición de cada tarjeta respecto a la activa: 0 al centro, ±1 a los lados, el resto escondidas.
  const relOf = (i: number) => {
    const n = slides.length;
    const rel = (((i - current) % n) + n) % n;
    return rel > n / 2 ? rel - n : rel;
  };

  const place = (slide: HTMLElement, rel: number) => {
    slide.style.setProperty('--rel', String(rel));
    slide.classList.toggle('is-active', rel === 0);
    slide.classList.toggle('is-side', Math.abs(rel) === 1);
    if (rel !== 0) slide.classList.remove('is-entering');
    slide.inert = rel !== 0;
  };

  const goTo = (index: number) => {
    const target = ((index % slides.length) + slides.length) % slides.length;
    if (target === current) return;
    // Lado por el que llega la tarjeta: el contenido entra desde ahí.
    stage?.style.setProperty('--dir', String(Math.sign(relOf(target))));
    current = target;
    slides.forEach((slide, i) => {
      const rel = relOf(i);
      const before = Number(slide.style.getPropertyValue('--rel'));
      // Al dar la vuelta, la tarjeta pasa escondida al otro lado en vez de cruzar por delante.
      if (Math.abs(rel - before) > 1 && Math.abs(rel) < 2) {
        slide.classList.add('is-jumping');
        place(slide, Math.sign(rel) * 2);
        void slide.offsetWidth;
        slide.classList.remove('is-jumping');
      }
      place(slide, rel);
    });
    // Reinicia la entrada escalonada del contenido en la tarjeta que llega.
    const incoming = slides[current];
    incoming.classList.remove('is-entering');
    void incoming.offsetWidth;
    incoming.classList.add('is-entering');
    const project = Number(incoming.dataset.project);
    picks.forEach((pick, i) => pick.setAttribute('aria-pressed', String(i === project)));
  };

  // El selector lleva a la copia más cercana del proyecto elegido.
  picks.forEach((pick, project) => {
    pick.addEventListener('click', () => {
      const nearest = slides
        .map((slide, i) => ({ i, project: Number(slide.dataset.project), distance: Math.abs(relOf(i)) }))
        .filter((s) => s.project === project)
        .sort((a, b) => a.distance - b.distance)[0];
      goTo(nearest.i);
    });
  });

  root?.querySelector('[data-prev]')?.addEventListener('click', () => goTo(current - 1));
  root?.querySelector('[data-next]')?.addEventListener('click', () => goTo(current + 1));

  // Con el foco en el selector o en las flechas, las teclas ← y → también cambian de proyecto.
  root?.addEventListener('keydown', (e) => {
    if (!(e.target as HTMLElement).closest('[data-picker], .carousel__arrow')) return;
    if (e.key === 'ArrowLeft') goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });

  // Las tarjetas de los lados no reciben clics: el clic cae en el escenario y lleva hacia ese lado.
  stage?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.carousel__slide.is-active')) return;
    const { left, right } = slides[current].getBoundingClientRect();
    if (e.clientX < left) goTo(current - 1);
    else if (e.clientX > right) goTo(current + 1);
  });

  // Deslizar con el dedo: las tarjetas siguen al dedo y, pasado el umbral, cambia de proyecto.
  let pointer: number | null = null;
  let startX = 0;
  let dx = 0;

  stage?.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse') return;
    pointer = e.pointerId;
    startX = e.clientX;
    dx = 0;
  });
  stage?.addEventListener('pointermove', (e) => {
    if (e.pointerId !== pointer) return;
    dx = e.clientX - startX;
    if (Math.abs(dx) > 8) stage.classList.add('is-dragging');
    if (stage.classList.contains('is-dragging')) stage.style.setProperty('--drag', `${dx}px`);
  });
  const release = (e: PointerEvent) => {
    if (e.pointerId !== pointer) return;
    pointer = null;
    stage?.classList.remove('is-dragging');
    stage?.style.setProperty('--drag', '0px');
    if (Math.abs(dx) > 60) goTo(current + (dx < 0 ? 1 : -1));
  };
  stage?.addEventListener('pointerup', release);
  stage?.addEventListener('pointercancel', release);
</script>

<style>
  .projects {
    position: relative;
    overflow: hidden;
    background: var(--c-bg-soft);
  }
  .projects :global(.projects__stripes) {
    position: absolute;
    right: -200px;
    top: -80px;
    width: 520px;
    height: auto;
    pointer-events: none;
  }
  .projects .container {
    position: relative;
  }
  .projects__head {
    max-width: 640px;
  }

  /* Selector de proyectos */
  .picker {
    position: relative;
    display: flex;
    gap: 10px;
    margin: 40px -4px 0;
    /* Espacio para el anillo de foco sin que el desplazamiento lo recorte. */
    padding: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .picker::-webkit-scrollbar {
    display: none;
  }
  .picker__item {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 8px;
    border-radius: 16px;
    border: 1px solid var(--c-border);
    background: #fff;
    color: var(--c-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .picker__item:hover {
    border-color: #c3ced6;
  }
  .picker__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--c-bg-soft);
    color: var(--c-blue);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .picker__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .picker__item strong {
    font-size: 0.92rem;
  }
  .picker__item small {
    font-size: 0.74rem;
    color: var(--c-muted);
    transition: color 0.25s ease;
  }
  .picker__item[aria-pressed='true'] {
    border-color: var(--pick-color);
    background: var(--pick-color);
    color: #fff;
  }
  .picker__item[aria-pressed='true'] .picker__icon {
    background: rgb(255 255 255 / 0.12);
    color: var(--c-lime);
  }
  .picker__item[aria-pressed='true'] small {
    color: rgb(255 255 255 / 0.65);
  }

  /* Carrusel: la tarjeta activa al centro y las vecinas asomando a los lados, más chicas y desvanecidas. */
  .carousel {
    --gap: 32px;
    --peek: 28px;
    --side-scale: 0.9;
    --slide-w: min(1140px, 100% - 2 * (var(--gap) + var(--peek)));
    position: relative;
    margin-top: 24px;
  }
  .carousel__stage {
    display: grid;
    touch-action: pan-y;
    cursor: pointer;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 calc(50% - var(--slide-w) / 2),
      #000 calc(50% + var(--slide-w) / 2),
      transparent
    );
  }
  /* Todas ocupan la misma celda: la sección mide lo que la tarjeta más alta y no salta al cambiar. */
  .carousel__slide {
    --scale: 1;
    grid-area: 1 / 1;
    justify-self: center;
    display: grid;
    /* La tarjeta no puede ser más ancha que su espacio, aunque su contenido lo pida. */
    grid-template-columns: minmax(0, 1fr);
    width: var(--slide-w);
    transform: translateX(calc(var(--rel) * (100% * (1 + var(--side-scale)) / 2 + var(--gap)) + var(--drag, 0px)))
      scale(var(--scale));
    transition:
      transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.6s ease,
      visibility 0.6s;
  }
  .carousel__slide.is-active {
    cursor: auto;
  }
  .carousel__slide:not(.is-active) {
    --scale: var(--side-scale);
    pointer-events: none;
  }
  .carousel__slide.is-side {
    opacity: 0.5;
  }
  .carousel__slide:not(.is-active, .is-side) {
    opacity: 0;
    visibility: hidden;
  }
  .carousel__stage.is-dragging .carousel__slide,
  .carousel__slide.is-jumping {
    transition: none;
  }

  /* Al llegar, el contenido de la tarjeta entra escalonado desde el lado por el que viene. */
  .carousel__slide.is-entering
    :global(:is(.showcase__tag, .showcase__brand, .showcase__lead, .showcase__list li, .showcase__copy > .btn, .showcase__actions)) {
    animation: project-in 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
  }
  .carousel__slide.is-entering :global(.showcase__visual) {
    animation: project-visual-in 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.1s backwards;
  }
  .carousel__slide.is-entering :global(.showcase__tag) {
    animation-delay: 0.1s;
  }
  .carousel__slide.is-entering :global(.showcase__brand) {
    animation-delay: 0.15s;
  }
  .carousel__slide.is-entering :global(.showcase__lead) {
    animation-delay: 0.2s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(1)) {
    animation-delay: 0.25s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(2)) {
    animation-delay: 0.29s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(3)) {
    animation-delay: 0.33s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(4)) {
    animation-delay: 0.37s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(5)) {
    animation-delay: 0.41s;
  }
  .carousel__slide.is-entering :global(.showcase__list li:nth-child(n + 6)) {
    animation-delay: 0.45s;
  }
  .carousel__slide.is-entering :global(:is(.showcase__copy > .btn, .showcase__actions)) {
    animation-delay: 0.5s;
  }
  @keyframes project-in {
    from {
      opacity: 0;
      transform: translateX(calc(var(--dir, 1) * 36px));
    }
  }
  @keyframes project-visual-in {
    from {
      opacity: 0;
      transform: translateX(calc(var(--dir, 1) * 56px)) scale(0.96);
    }
  }
  @keyframes project-fade {
    from {
      opacity: 0;
    }
  }

  /* Las flechas montan sobre los bordes de la tarjeta activa. */
  .carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--c-ink);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .carousel__arrow:hover {
    background: var(--c-lime);
    color: var(--c-ink-900);
  }
  .carousel__arrow--prev {
    left: calc(50% - var(--slide-w) / 2);
  }
  .carousel__arrow--prev :global(svg) {
    transform: scaleX(-1);
  }
  .carousel__arrow--next {
    left: calc(50% + var(--slide-w) / 2);
  }

  /* Sin espacio de sobra a los lados, la tarjeta activa conserva el ancho y las vecinas solo asoman el borde. */
  @media (max-width: 1180px) {
    .carousel {
      --gap: 16px;
      --peek: 14px;
    }
  }
  /* En celular se cambia deslizando o con el selector. */
  @media (max-width: 640px) {
    .picker {
      margin-top: 32px;
      margin-inline: -20px;
      padding-inline: 20px;
    }
    .carousel {
      --gap: 12px;
      --peek: 16px;
    }
    .carousel__stage {
      mask-image: none;
    }
    .carousel__arrow {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .picker__item {
      padding-right: 14px;
    }
    .picker__item small {
      display: none;
    }
  }
  @media (max-width: 360px) {
    /* Sin ícono para que los botones del selector quepan enteros. */
    .picker__item {
      padding: 10px 16px;
    }
    .picker__icon {
      display: none;
    }
    .carousel {
      --gap: 8px;
      --peek: 8px;
    }
  }
  /* Con «reducir movimiento» nada se desplaza: las tarjetas cambian con un fundido suave. */
  @media (prefers-reduced-motion: reduce) {
    .picker__item,
    .picker__icon,
    .picker__item small,
    .carousel__arrow {
      transition: none;
    }
    .carousel__slide {
      transition: opacity 0.4s ease;
    }
    .carousel__slide.is-entering
      :global(:is(.showcase__tag, .showcase__brand, .showcase__lead, .showcase__list li, .showcase__copy > .btn, .showcase__actions, .showcase__visual)) {
      animation-name: project-fade;
    }
  }
</style>
