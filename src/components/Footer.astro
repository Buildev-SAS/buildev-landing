    '<path fill="currentColor" d="M9.1 23.69v-7.98H6.63V12h2.47v-1.58c0-4.09 1.85-5.98 5.86-5.98.76 0 2.07.15 2.61.3v3.32c-.28-.03-.78-.04-1.39-.04-1.97 0-2.73.75-2.73 2.68V12h3.92l-.67 3.71h-3.25v8.35C19.4 23.33 24 18.2 24 12c0-6.63-5.37-12-12-12S0 5.37 0 12c0 5.63 3.88 10.35 9.1 11.69z"/>',
