---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <Logo class="footer__logo" />
      <p class="footer__claim">{t.footerClaim}</p>
      <h4 class="footer__follow">{t.footerFollow}</h4>
      <ul class="footer__social">
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={socialIcons[s.name]} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label={t.footerAria}>
      <h4>{t.footerNav}</h4>
      <ul>
        {nav.map((item) => <li><a href={navHref(item.href, Astro.url)}>{item.label[lang]}</a></li>)}
        {resources.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h4>{t.footerContact}</h4>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="https://agendorio.buildev.co" target="_blank" rel="noopener">agendorio.buildev.co</a></li>
        <li><a href="https://rentablo.buildev.co" target="_blank" rel="noopener">rentablo.buildev.co</a></li>
        <li>{t.city}</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} BUILDEV. {t.rights} · <a href={paths.privacy[lang]}>{t.privacy}</a></span>
    <span>Software Solutions &amp; Innovation</span>
  </div>
</footer>

<style>
  .footer {
    padding-top: 64px;
    background: #fff;
    border-top: 4px solid transparent;
    border-image: var(--grad-brand) 1;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
  }
  .footer :global(.footer__logo) {
    font-size: 17px;
  }
  .footer__claim {
    margin-top: 18px;
    color: var(--c-muted);
    font-weight: 600;
  }
  .footer__follow {
    margin-top: 26px;
  }
  .footer .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--c-border);
    border-radius: 50%;
    color: var(--c-ink);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .footer .footer__social a:hover {
    color: #fff;
    border-color: var(--c-blue);
    background: var(--c-blue);
  }
  .footer h4 {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-blue);
  }
  .footer ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.94rem;
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }
  .footer ul a:hover {
    color: var(--c-ink);
  }
  .footer__bottom {
    margin-top: 48px;
    padding-block: 22px;
    border-top: 1px solid var(--c-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--c-muted);
  }
  .footer__bottom a {
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .footer__bottom a:hover {
    color: var(--c-ink);
  }

  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__grid > :first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    /* Las dos columnas no caben con el correo y los dominios: van una debajo de la otra. */
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .footer :global(.footer__logo) {
      font-size: 14px;
    }
  }
</style>
