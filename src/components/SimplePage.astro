---
import Layout from '../layouts/Layout.astro';
import Logo from './Logo.astro';
import Stripes from './Stripes.astro';

interface Props {
  title: string;
  heading: string;
  text: string;
}

const { title, heading, text } = Astro.props;
---

<Layout title={title}>
  <main class="simple">
    <Stripes class="simple__stripes" />
    <div class="simple__box">
      <a href="/" aria-label="Volver al inicio"><Logo variant="dark" /></a>
      <h1>{heading}</h1>
      <p>{text}</p>
      <a href="/" class="btn btn--primary">Volver al inicio</a>
    </div>
  </main>
</Layout>

<style>
  .simple {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px 20px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--c-ink-900), var(--c-ink));
    color: #fff;
    text-align: center;
  }
  .simple :global(.simple__stripes) {
    position: absolute;
    right: -120px;
    bottom: -60px;
    width: 640px;
    height: auto;
    opacity: 0.18;
  }
  .simple__box {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 22px;
    max-width: 520px;
    font-size: 16px;
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  p {
    color: rgb(255 255 255 / 0.75);
  }
</style>
