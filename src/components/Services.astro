---
import Icon, { type IconName } from './Icon.astro';
import { getLang, type Lang } from '../i18n';
import { guiaHref } from '../data/guias';

const lang = getLang(Astro.url);
const copy = {
  es: {
    eyebrow: 'Servicios',
    title: 'Tecnología que resuelve problemas reales',
    lead: 'Acompañamos a tu empresa desde la idea hasta la puesta en producción, con soluciones pensadas para durar y escalar.',
  },
  en: {
    eyebrow: 'Services',
    title: 'Technology that solves real problems',
    lead: 'We partner with your company from idea to production, with solutions built to last and scale.',
  },
}[lang];

// `guide`: enlace opcional a la guía que amplía el servicio.
const services: {
  icon: IconName;
  title: Record<Lang, string>;
  text: Record<Lang, string>;
  guide?: { href: Record<Lang, string>; label: Record<Lang, string> };
}[] = [
  {
    icon: 'code',
    title: { es: 'Software a la medida', en: 'Custom software' },
    text: {
      es: 'Construimos plataformas y sistemas diseñados para la forma en que trabaja tu empresa, no al revés.',
      en: 'We build platforms and systems designed around the way your company works, not the other way around.',
    },
  },
  {
    icon: 'monitor',
    title: { es: 'Aplicaciones web', en: 'Web applications' },
    text: {
      es: 'Portales, paneles administrativos y productos SaaS rápidos, modernos y fáciles de usar.',
      en: 'Fast, modern, easy-to-use portals, admin dashboards and SaaS products.',
    },
  },
  {
    icon: 'phone',
    title: { es: 'Apps móviles', en: 'Mobile apps' },
    text: {
      es: 'Experiencias móviles que acercan tu servicio a tus clientes, disponibles donde ellos estén.',
      en: 'Mobile experiences that bring your service closer to your customers, wherever they are.',
    },
  },
  {
    icon: 'zap',
    title: { es: 'Automatización de procesos', en: 'Process automation' },
    text: {
      es: 'Eliminamos tareas repetitivas y reducimos errores para que tu equipo se enfoque en lo importante.',
      en: 'We eliminate repetitive tasks and reduce errors so your team can focus on what matters.',
    },
    guide: {
      href: { es: guiaHref('es', 'como-automatizar-procesos-en-tu-empresa'), en: guiaHref('en', 'how-to-automate-business-processes') },
      label: { es: 'Cómo automatizar los procesos de tu negocio', en: 'How to automate business processes' },
    },
  },
  {
    icon: 'link',
    title: { es: 'Integraciones y APIs', en: 'Integrations and APIs' },
    text: {
      es: 'Conectamos tus sistemas, pasarelas de pago, WhatsApp y servicios de terceros en un solo flujo.',
      en: 'We connect your systems, payment gateways, WhatsApp and third-party services into a single workflow.',
    },
  },
  {
    icon: 'cloud',
    title: { es: 'Cloud y despliegue', en: 'Cloud and deployment' },
    text: {
      es: 'Infraestructura en la nube escalable, monitoreada y segura, lista para crecer con tu operación.',
      en: 'Scalable, monitored and secure cloud infrastructure, ready to grow with your operations.',
    },
  },
];
---

<section class="section services" id="servicios">
  <div class="container">
    <header class="services__head reveal">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-lead">
        {copy.lead}
      </p>
    </header>

    <div class="services__grid">
      {
        services.map((s, i) => (
          <article class="card reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <span class="card__icon">
              <Icon name={s.icon} size={26} />
            </span>
            <h3>{s.title[lang]}</h3>
            <p>{s.text[lang]}</p>
            {s.guide && (
              <a class="card__link" href={s.guide.href[lang]}>
                {s.guide.label[lang]} <Icon name="arrow" size={16} />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--c-bg-soft);
  }
  .services__head {
    max-width: 680px;
  }
  .services__grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    position: relative;
    padding: 32px 28px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--c-border);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      opacity 0.7s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  .card:hover::before {
    transform: scaleX(1);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgb(166 217 54 / 0.16), rgb(0 184 217 / 0.16));
    color: var(--c-blue);
  }
  .card h3 {
    margin-top: 22px;
    font-size: 1.18rem;
  }
  .card p {
    margin-top: 10px;
    color: var(--c-muted);
    font-size: 0.96rem;
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--c-blue);
  }
  .card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
